# ==========================================
# 🔑 Maxfiylik va Sozlamalar (CRITICAL!)
# ==========================================
# API kalitlar, parollar va maxfiy ma'lumotlar saqlanadigan fayllar
.env
.env.*
!.env.example     # Misol tariqasidagi fayl o'tib ketishiga ruxsat beramiz
*.pot
*.pyc
secrets.toml

# ==========================================
# 🚀 Django REST Framework xususiy fayllari
# ==========================================
